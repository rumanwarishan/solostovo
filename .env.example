# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Stripe (https://dashboard.stripe.com/test/apikeys) — use test keys until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build absolute success/cancel URLs when the request has no Origin header
# (e.g. server-to-server calls). Set to your deployed URL in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Basic Auth credentials gating /admin — required, there is no default password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
