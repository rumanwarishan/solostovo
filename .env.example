# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Stripe (https://dashboard.stripe.com/test/apikeys) — use test keys until you're ready to go live.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build absolute success/cancel URLs when the request has no Origin header
# (e.g. server-to-server calls). Set to your deployed URL in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Gates /admin. Without a database, this is a single Basic Auth login —
# required, there is no default password. With a database connected, these
# credentials only seed the FIRST admin account on first run; add or remove
# further admins from Admin → Users instead of editing this file.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# MySQL database. Without these set, the site runs on the built-in
# placeholder catalog and admin editing is disabled — see README for setup.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
